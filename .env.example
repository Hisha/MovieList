# MovieList 2.0 configuration — copy to .env and edit.
# NEVER commit the real .env file (it is gitignored).

# --- Kodi video database (read-only account; see scripts/setup_readonly_user.sql)
KODI_DB_HOST=192.168.10.11
KODI_DB_PORT=3306
KODI_DB_NAME=MyVideos131
KODI_DB_USER=movielist
KODI_DB_PASSWORD=change-me-strong-password
KODI_DB_CONNECT_TIMEOUT=5
KODI_DB_READ_TIMEOUT=15
KODI_DB_POOL_SIZE=5

# --- Application server
MOVIELIST_HOST=127.0.0.1
MOVIELIST_PORT=8000
MOVIELIST_ROOT_PATH=/ML

# --- UI
MOVIELIST_PAGE_SIZE=48
MOVIELIST_SHOWS_PAGE_SIZE=36
MOVIELIST_RECENT_COUNT=12

# --- Artwork cache
ARTWORK_CACHE_DIR=/var/lib/movielist/artwork_cache
ARTWORK_CACHE_MAX_SIZE=2147483648
ARTWORK_CONNECT_TIMEOUT=5
ARTWORK_READ_TIMEOUT=15
ARTWORK_MAX_BYTES=26214400
ARTWORK_MAX_DIMENSION=10000
ARTWORK_FAILURE_TTL=3600

# Map Kodi SMB paths to local mounts (comma separated, or a JSON object).
# Only mapped paths are readable; no mount is required if all artwork
# is resolved through approved remote hosts.
MEDIA_PATH_MAPPINGS=smb://192.168.10.11/MediaDrive/=/mnt/MediaDrive

# Extra local directories allowed for artwork file reads (os.pathsep separated).
# Mapping targets are always allowed.
#ARTWORK_ALLOWED_DIRS=/mnt/MediaDrive/Movies

# Hosts allowed for remote artwork downloads (comma separated).
# Kodi TMDB artwork normally lives on image.tmdb.org.
APPROVED_ARTWORK_HOSTS=image.tmdb.org,assets.fanart.tv,www.themoviedb.org

LOG_LEVEL=INFO

[Unit]
Description=MovieList 2.0 - read-only Kodi media catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=movielist
Group=movielist
WorkingDirectory=/opt/movielist
ExecStart=/opt/movielist/ML_env/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Hardening: the app needs only its own tree and the artwork cache.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/movielist

# Logging: journald captures stdout/stderr (no file logging required).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=movielist

[Install]
WantedBy=multi-user.target
